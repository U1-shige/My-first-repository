# ============================================================
# Box-Claude 自動同期スクリプト 設定ファイル
# このファイルを .env にコピーして値を記入してください
# cp .env.example .env
# ============================================================

# ---- Anthropic (Claude API) ----
# https://console.anthropic.com/ でAPIキーを取得
ANTHROPIC_API_KEY=sk-ant-...

# ---- Box 認証 ----
# 【簡単】Developerトークン（60分限定・動作確認用）
#   https://app.box.com/developers/console でアプリを作成
#   「Configuration」タブ → 「Developer Token」→「Generate Developer Token」
BOX_ACCESS_TOKEN=your_developer_token_here

# 【推奨・長期運用用】OAuth2 トークン
#   以下を追加で設定するとトークンが自動更新されます
# BOX_CLIENT_ID=your_client_id
# BOX_CLIENT_SECRET=your_client_secret
# BOX_REFRESH_TOKEN=your_refresh_token

# ---- Box フォルダパス ----
BOX_PROMPT_FOLDER=Claude/prompts
BOX_RESULT_FOLDER=Claude/results
BOX_PROCESSED_FOLDER=Claude/processed

# ---- スクリプト動作設定 ----
POLL_INTERVAL=60           # フォルダをチェックする間隔（秒）
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8192
